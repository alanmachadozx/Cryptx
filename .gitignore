# Ignore byte-compiled / cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Python virtual environments
venv/
.env/
.venv/
env/
ENV/

# Python build / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
htmlcov/
.tox/
.pytest_cache/

# C/C++ build artifacts
*.o
*.obj
*.so
*.a
*.dll
*.exe
*.out
*.app

# CMake / Make / generic build dirs
build/
bin/
obj/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
Makefile.user

# Qt / QML / QMake
*.qmlcache
moc_*
qrc_*
*.pro.user
*.qmake.stash
*.autosave

# Rust target (just in case)
/target/

# Node (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript build
dist/
*.tsbuildinfo

# IDEs / editors
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS files
.DS_Store
Thumbs.db

# Logs, temporary
*.log
tmp/
temp/
.cache/

# Misc
*.bak
*.swp
*~
